# ============================================================================
# Caddyfile — origin 端反向代理 / 靜態檔伺服器(跑在 Oracle A1)
# ----------------------------------------------------------------------------
# 角色:Caddy 只聽 127.0.0.1:8080(不對外),作為 cloudflared 連入的唯一 origin,
#       依 Host 把請求分流到各站(靜態檔 / 反代後端)。
# 資料流:cloudflared → http://127.0.0.1:8080(本檔)→ file_server / reverse_proxy
#
# 為什麼 http:// + auto_https off:TLS 已在 Cloudflare 邊緣終結,Tunnel 內已加密,
#   origin 不需也不該再自簽憑證。http_port 8080 讓所有 http:// 站台改聽 8080。
#
# steam / erp 兩個 vhost 的上游埠號已與線上實際設定核對(2026-07-28,ssh 實查
#   /etc/caddy/Caddyfile 與 ss -tlnp):steam api=127.0.0.1:8788、erp=127.0.0.1:8081,
#   皆為各自 repo 的 docker compose publish 在 loopback 的埠。
# ============================================================================

{
	auto_https off
	http_port 8080          # http:// 站台改聽 8080(對上 cloudflared 轉發的 127.0.0.1:8080)
	admin localhost:2019
}

# --- 主站:terrychou.com → /srv/main 靜態檔 -------------------------------
# ⚠️ 不做 SPA fallback:主站是 Next.js `output: 'export'` 的純靜態匯出,out/ 內有真實的
#    404.html。若 fallback 到 /index.html,任何不存在的路徑都會回 200 首頁(軟 404),
#    Google 會把無限多垃圾網址當成重複首頁收錄,壞連結也看不出來。
#
# ⚠️ 用 handle 區塊隔離(手法同下方 soulshard vhost):try_files 屬 rewrite 階段、
#    順序早於 respond,/healthz 若與靜態群組同層會先被改寫成別的路徑而永不命中。
http://terrychou.com {
	bind 127.0.0.1
	encode zstd gzip

	# 健康檢查:獨立 handle,不受靜態群組的 try_files 影響(對應 deploy-static.sh)。
	handle /healthz {
		respond 200
	}

	handle {
		root * /srv/main
		file_server
		# trailingSlash: true 的匯出結構為 <path>/index.html;只補目錄索引,
		# 找不到就讓它落到 handle_errors,不再 fallback 首頁。
		try_files {path} {path}/index.html
	}

	# 匯出的 404.html 以真正的狀態碼回應(file_server 的 status 子指令需 Caddy >= 2.7)。
	handle_errors {
		root * /srv/main
		rewrite * /404.html
		file_server {
			status {err.status_code}
		}
	}
}

# --- live demo:soulshard.terrychou.com ------------------------------------
# 前端為純靜態遊戲(/srv/soulshard);後端 Soulshard-Hunter `server/`(Node+Fastify+
# Postgres)以 docker compose 跑在 127.0.0.1:8787,提供 REST(/api/*)與 co-op
# WebSocket(/rt)。
#
# ⚠️ 用 handle 區塊隔離:Caddy 的 try_files 屬 rewrite 階段、順序在 reverse_proxy
#    之前,若不隔離會把 /api/* 先改寫成 /index.html 而打不到後端。handle 群組互斥,
#    /api 與 /rt 命中 @backend 群組,其餘才進靜態群組(try_files 只作用於此)。
http://soulshard.terrychou.com {
	bind 127.0.0.1
	encode zstd gzip

	@backend path /api/* /rt /rt/*
	handle @backend {
		reverse_proxy 127.0.0.1:8787   # reverse_proxy 會自動處理 WebSocket upgrade
	}

	handle {
		root * /srv/soulshard
		file_server
		try_files {path} {path}/ /index.html
	}
}

# --- live app:steam.terrychou.com(SteamSaleChecker,獨立 repo 部署)-------
# 前端為靜態站(/srv/steam);api + worker 以 docker compose 跑在本機,Caddy 同站代理
# /api 與 /auth(結構與 soulshard 相同,故一樣用 handle 區塊隔離 try_files)。
#
http://steam.terrychou.com {
	bind 127.0.0.1
	encode zstd gzip

	@backend path /api/* /auth/*
	handle @backend {
		reverse_proxy 127.0.0.1:8788
	}

	handle {
		root * /srv/steam
		file_server
		try_files {path} {path}/ /index.html
	}
}

# --- live app:erp.terrychou.com(ERPSystem,獨立 repo 部署)----------------
# 全端應用(Spring Boot 後端 + React 前端,由該 repo 自己的 docker compose 起,
# 站內含 nginx),因此這裡整站反代、不在本機放靜態檔。
#
http://erp.terrychou.com {
	bind 127.0.0.1
	encode zstd gzip
	reverse_proxy 127.0.0.1:8081
}

